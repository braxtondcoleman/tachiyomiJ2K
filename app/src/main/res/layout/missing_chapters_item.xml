<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <View
        android:layout_width="0dp"
        android:layout_height="0.75dp"
        android:layout_weight="1"
        android:alpha="0.54"
        android:background="?attr/colorOnBackground" />

    <TextView
        android:id="@+id/missing_chapters_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?android:textColorSecondary"
        tools:text="Missing 5 chapters" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_fix_missing_chapters"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:contentDescription="Find missing chapters from installed sources"
        android:minWidth="64dp"
        android:text="Fix"
        android:textAllCaps="false"
        app:icon="@drawable/ic_build_24dp"
        app:iconGravity="textStart"
        app:iconSize="18dp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0.75dp"
        android:layout_weight="1"
        android:alpha="0.54"
        android:background="?attr/colorOnBackground" />

</LinearLayout>
